# =============================================================================
# Exchange API Keys
# =============================================================================
# Copy this file to .env and fill in your real credentials.
# .env is gitignored and will never be committed.
#
# These override values in config/default.toml via the MM_ prefix.
# Double underscores map to TOML nesting:
#   MM_EXCHANGES__BINANCE__API_KEY -> exchanges.binance.api_key

# Binance
MM_EXCHANGES__BINANCE__API_KEY=
MM_EXCHANGES__BINANCE__SECRET_KEY=
MM_EXCHANGES__BINANCE__ENABLED=false

# Coinbase
MM_EXCHANGES__COINBASE__API_KEY=
MM_EXCHANGES__COINBASE__SECRET_KEY=
MM_EXCHANGES__COINBASE__ENABLED=false

# Kraken
MM_EXCHANGES__KRAKEN__API_KEY=
MM_EXCHANGES__KRAKEN__SECRET_KEY=
MM_EXCHANGES__KRAKEN__ENABLED=false

# Alpaca
MM_EXCHANGES__ALPACA__API_KEY=
MM_EXCHANGES__ALPACA__SECRET_KEY=
MM_EXCHANGES__ALPACA__ENABLED=true
